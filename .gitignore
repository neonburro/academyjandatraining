.env
.env.local
.env.production
.env.*.local

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Netlify
.netlify

# Misc
*.log
manuals/

# Claude local session settings
.claude/

# Bridge cleanup staging (files the cloud session could not delete)
_to_delete/

# Local MCP config holds the Supabase access token. Never commit.
.mcp.json
